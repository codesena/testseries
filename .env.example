DATABASE_URL="postgresql://testseries:testseries@localhost:5432/testseries?schema=public"
# Optional for hosted PostgreSQL: use a direct connection string for Prisma CLI / migrations.
DIRECT_URL="postgresql://testseries:testseries@localhost:5432/testseries?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_IDLE_TIMEOUT_MS="300000"
NEXT_PUBLIC_HEARTBEAT_INTERVAL_MS="30000"

# Notion import (optional)
# Create an internal integration in Notion, share your Questions database with it,
# and paste the integration token + database id here.
NOTION_TOKEN="secret_xxx"
NOTION_DATABASE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: if NOTION_DATABASE_ID points to a Notion page that contains multiple embedded
# databases, set this to the exact database title to choose the right one.
NOTION_DATABASE_TITLE=""

# Import mode: "error" (default) or "replace" (delete existing test with same title)
NOTION_IMPORT_MODE="error"

# Admin image upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
